# Ключ OpenRouter — получить на https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Необязательно: какую модель дёргать через OpenRouter.
# Каталог моделей: https://openrouter.ai/models
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Необязательно: атрибуция приложения в статистике OpenRouter
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=PowerBI AI Assistant

# Придумайте длинную случайную строку — будет проверяться в заголовке запроса от Make
WEBHOOK_SECRET=change-me-to-random-string
