# Ключ Anthropic API — получить на https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Данные Azure AD приложения (service principal) для доступа к Power BI.
# Как создать — см. README.md, раздел "Настройка Power BI".
POWERBI_TENANT_ID=00000000-0000-0000-0000-000000000000
POWERBI_CLIENT_ID=00000000-0000-0000-0000-000000000000
POWERBI_CLIENT_SECRET=your-client-secret-value

# ID датасета (тот же, что уже используется в Make: 690df9f0-812f-4057-bf07-99dc55e41f1d)
POWERBI_DATASET_ID=690df9f0-812f-4057-bf07-99dc55e41f1d

# Придумайте длинную случайную строку — будет проверяться в заголовке запроса от Make
WEBHOOK_SECRET=change-me-to-random-string
